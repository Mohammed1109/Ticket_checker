<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lucky Draw Ticket Checker</title>

<style>
body {
    margin:0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.container {
    background:#111827;
    padding:30px;
    border-radius:15px;
    width:90%;
    max-width:400px;
    text-align:center;
    box-shadow:0 10px 30px rgba(0,0,0,0.5);
}

h2 {
    margin-bottom:25px;
}

input {
    width:100%;
    padding:12px;
    font-size:18px;
    border-radius:8px;
    border:none;
    text-align:center;
    margin-bottom:15px;
}

button {
    width:100%;
    padding:12px;
    font-size:16px;
    border:none;
    border-radius:8px;
    background:#22c55e;
    color:white;
    cursor:pointer;
}

button:hover {
    background:#16a34a;
}

#result {
    margin-top:20px;
    font-size:20px;
    font-weight:bold;
}

.valid { color:#22c55e; }
.invalid { color:#ef4444; }
</style>
</head>

<body>

<div class="container">
    <h2>🎟 Lucky Draw Ticket Checker</h2>
    <input type="number" id="ticket" placeholder="Enter Ticket Number">
    <button onclick="checkTicket()">Check Ticket</button>
    <div id="result"></div>
</div>

<script>
function checkTicket() {
    const num = parseInt(document.getElementById("ticket").value);
    const result = document.getElementById("result");

    if (isNaN(num)) {
        result.innerHTML = "Enter a valid number.";
        result.className = "invalid";
        return;
    }

    const valid =
        (num >= 6401 && num <= 6414) ||
        (num >= 6416 && num <= 6432) ||
        (num >= 6442 && num <= 6460);

    if (valid) {
        result.innerHTML = "✅ This ticket EXISTS in your list.";
        result.className = "valid";
    } else {
        result.innerHTML = "❌ This ticket does NOT exist.";
        result.className = "invalid";
    }
}
</script>

</body>
</html>
